  "cards": [
    {
      "dot": "cyan",
      "title": "The tiers (TorrentLeech)",
      "items": [
        "Headroom under 25 GB: freeleech only, 3 grabs a day",
        "25 to 100 GB: freeleech only, 2 grabs a day",
        "Over 100 GB: all results, 1 grab a day",
        "headroom = (uploaded - min_ratio x downloaded) / min_ratio; freeleech never moves downloaded"
      ]
    },
    {
      "dot": "amber",
      "title": "Read, not steered",
      "items": [
        "DigitalCore, C411 and retrotoon have no tiers: their numbers are only exported and alerted on",
        "Hit and run clocks come from qBittorrent, so they exist even when a login fails",
        "Sonarr keeps the indexer at every tier: the filter lives in Prowlarr because Sonarr has no requiredFlags"
      ]
    },
    {
      "dot": "rose",
      "title": "Alerts on the loop",
      "items": [
        "Almost no paid downloads left; ratio under the line; an obligation with the clock stopped; numbers not being read",
        "tracker-control posts each knob change to Telegram itself; Grafana sends the alerts",
        "Nothing is written when a value already matches, so it is silent except at a crossing"
      ]
    }
  ]
