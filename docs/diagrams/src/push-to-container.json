  "cards": [
    {
      "dot": "emerald",
      "title": "The pin is the deploy",
      "items": [
        "A source push changes nothing on the Pi until CI commits the new tag to versions.env",
        "Tags are never rebuilt: a tag already on GHCR is skipped",
        "Comparing against the pinned tag's commit lets a failed run catch up on the next one"
      ]
    },
    {
      "dot": "amber",
      "title": "Two triggers, one script",
      "items": [
        "raspi: webhook on every push, cron every 30 min as the self-heal net",
        "streamhalla: cron only, same repo, same main branch",
        "Both workflows that commit to versions.env share one concurrency group"
      ]
    },
    {
      "dot": "slate",
      "title": "App images",
      "items": [
        "bifrost, sleipnir and muninn are built in their own repos",
        "Their release dispatches Deploy app with the tag; compose up pulls it on the next pass"
      ]
    }
  ]
