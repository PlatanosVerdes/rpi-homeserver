  "cards": [
    {
      "dot": "cyan",
      "title": "Per-tracker groups (qbit-manage share_limits)",
      "items": [
        "1 stalled: removed 12 h after the last byte moved",
        "2 cross-seed: 15 d, no ratio limit; 3 manual: 15 d, then stopped, file kept",
        "4 TorrentLeech 15 d or 1.2; 5 retrotoon 120 h, no ratio; 6 c411 150 h or 1.0",
        "7 DigitalCore 180 h or 1.0; 8 any other private 10 d or 1.0; 9 public 2 h",
        "Private groups also need noHL, ratio or cross-seed, and 1 day without activity"
      ]
    },
    {
      "dot": "amber",
      "title": "Out of the clock",
      "items": [
        "keep (a person) and keep-bonus (tracker-control) are excluded by every group",
        "manual torrents are paused at the limit, never deleted",
        "A tracker error is only tagged; rem_unregistered removes what the site disowned"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why the hardlink matters",
      "items": [
        "The arr imports by hardlink; Maintainerr deletes the library copy 2 days after a 95% watch",
        "While the library holds the file, seeding costs no disk",
        "A RAR release is extracted to new bytes, so its torrent is noHL from the start",
        "Deleting lands in /data/downloads/.RecycleBin, so space returns a day later"
      ]
    }
  ]
