  "cards": [
    {
      "dot": "cyan",
      "title": "Three ways a number arrives",
      "items": [
        "Scraped: exporters, pi-metrics, tracker-control, muninn, cloudflared, tailscale-metrics",
        "Probed: any container with a prometheus.probe label, found through the Docker socket; prometheus.probe.access checks a public app still demands the Access login",
        "Pushed: apply.sh, backup.sh and the deploy webhook, whose values outlive the job"
      ]
    },
    {
      "dot": "rose",
      "title": "Alerting",
      "items": [
        "All 40 rules query Prometheus; logs feed dashboards, not alerts",
        "apply.sh renders the Telegram contact point from .env, so the token is never committed",
        "Warnings repeat every 24 h, criticals every 6 h",
        "tracker-control also posts its own knob changes to Telegram"
      ]
    },
    {
      "dot": "amber",
      "title": "When the Pi itself is down",
      "items": [
        "Grafana dies with it, so heartbeat.sh pings healthchecks.io every minute",
        "It sends /fail when caddy or prometheus is not running, unless a deploy holds the lock"
      ]
    }
  ]
