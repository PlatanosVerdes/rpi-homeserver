{
    email {env.CADDY_EMAIL}
}

(cf_tls) {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

# --- HTTPS via Cloudflare DNS (Tailscale access) ---
https://raspi.platanosverdes.com {
    import cf_tls
    reverse_proxy homepage:3000 {
        flush_interval -1
    }
}
https://jellyfin.platanosverdes.com {
    import cf_tls
    reverse_proxy jellyfin:8096
}
https://overseerr.platanosverdes.com {
    import cf_tls
    reverse_proxy overseerr:5055
}
# Plex must be reached on the address it publishes as local=true, or the client shows the Remote
# Watch Pass paywall. Proxying breaks that twice over, so bounce the browser at the server instead:
# same URL to remember, direct connection underneath. Reachable from the tailnet via the subnet
# routes the Pi advertises, see docs/tailscale.md.
https://plex.platanosverdes.com {
    import cf_tls
    redir http://{env.STATIC_IP}:32400{uri}
}
https://logs.platanosverdes.com {
    import cf_tls
    reverse_proxy victorialogs:9428
}
https://grafana.platanosverdes.com {
    import cf_tls
    reverse_proxy grafana:3000
}
https://prometheus.platanosverdes.com {
    import cf_tls
    reverse_proxy prometheus:9090
}
https://push.platanosverdes.com {
    import cf_tls
    reverse_proxy pushgateway:9091
}
https://prowlarr.platanosverdes.com {
    import cf_tls
    reverse_proxy prowlarr:9696
}
https://radarr.platanosverdes.com {
    import cf_tls
    reverse_proxy radarr:7878
}
https://sonarr.platanosverdes.com {
    import cf_tls
    reverse_proxy sonarr:8989
}
https://torrent.platanosverdes.com {
    import cf_tls
    reverse_proxy qbittorrent:8080
}
https://speedtest.platanosverdes.com {
    import cf_tls
    reverse_proxy speedtest-tracker:80
}
https://pihole.platanosverdes.com {
    import cf_tls
    reverse_proxy host.docker.internal:8081
}
https://maintainerr.platanosverdes.com {
    import cf_tls
    reverse_proxy maintainerr:6246
}
https://bazarr.platanosverdes.com {
    import cf_tls
    reverse_proxy bazarr:6767
}
https://tautulli.platanosverdes.com {
    import cf_tls
    reverse_proxy tautulli:8181
}
https://subs.platanosverdes.com {
    import cf_tls
    reverse_proxy subtitle-links:8085
}
