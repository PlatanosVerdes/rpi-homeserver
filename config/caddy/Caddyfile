{
    email {env.CADDY_EMAIL}
}

# `log` in every site block writes an access log line per request to stderr as JSON, which
# Vector already collects from every container and ships to VictoriaLogs (see docs/logging.md).
# There is no separate pipeline for this, and no file on disk to rotate.
#
# It is worth having because nothing else knows which services actually get opened: Prometheus
# measures whether they are up, not whether anyone visits. The blackbox probes hit containers
# directly rather than these routes, so what lands here is real browser traffic only.

(cf_tls) {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

# --- HTTPS via Cloudflare DNS (Tailscale access) ---
https://raspi.platanosverdes.com {
    log
    # Homepage polls its own API to keep the widgets live, which is 98% of every request Caddy
    # sees: 136 of 139 lines over three minutes, none of them a visit. Logging it would bury the
    # thing the access log exists to answer and cost ~67k lines a day to do it.
    #
    # The whole /api tree, not a list of paths: naming them individually missed /api/hash,
    # /api/validate, /api/bookmarks and a /api/docker/stats/<container> call per service, and the
    # next widget added would have escaped too. Opening homepage is a page load, never an API call,
    # so nothing worth counting lives under here.
    @homepage_api path /api/*
    log_skip @homepage_api
    import cf_tls
    reverse_proxy homepage:3000 {
        flush_interval -1
    }
}
https://jellyfin.platanosverdes.com {
    log
    import cf_tls
    reverse_proxy jellyfin:8096
}
https://overseerr.platanosverdes.com {
    log
    import cf_tls
    reverse_proxy overseerr:5055
}
# Plex must be reached on the address it publishes as local=true, or the client shows the Remote
# Watch Pass paywall. Proxying breaks that twice over, so bounce the browser at the server instead:
# same URL to remember, direct connection underneath. Reachable from the tailnet via the subnet
# routes the Pi advertises, see docs/tailscale.md.
https://plex.platanosverdes.com {
    log
    import cf_tls
    redir http://{env.STATIC_IP}:32400{uri}
}
https://logs.platanosverdes.com {
    log
    import cf_tls
    reverse_proxy victorialogs:9428
}
https://farnsworth.platanosverdes.com {
    import cf_tls
    reverse_proxy farnsworth:8086
}
https://grafana.platanosverdes.com {
    log
    # Same reason as homepage above: an open Grafana tab holds a websocket and pings /api/login
    # constantly, which was 47 of 47 requests over 90 seconds with nobody touching it. That is a
    # tab being open, not a visit, and it would drown out every service that is one.
    @grafana_keepalive path /api/live/ws /api/login/ping
    log_skip @grafana_keepalive
    import cf_tls
    reverse_proxy grafana:3000
}
https://prometheus.platanosverdes.com {
    log
    import cf_tls
    reverse_proxy prometheus:9090
}
