apiVersion: 1

# TEMPLATE, not a provisioning file. apply.sh renders it into
# appdata/grafana-alerting/ (gitignored), which is the directory Grafana actually reads.
# Both values come from .env, so neither the token nor the chat id is ever committed.
#
# Why render instead of using Grafana's own $VAR interpolation: Grafana re-infers the type of an
# interpolated value, so an all-digits chat id comes back as a number while its Telegram
# integration demands a string. Provisioning then fails, and a failed alerting provisioning takes
# Grafana's whole startup down, not just the alert.
#
# On the message body:
#   - Alerts arrive grouped by alertname (policies.yml), so the name is the title and the
#     instances are the list underneath. One alert reads as a sentence, ten read as a list.
#   - The description goes in an expandable blockquote (Bot API 10.1). Long text collapses to two
#     lines and opens on tap, which keeps a chat of alerts scannable.
#   - No .Values anywhere: every rule compares with PromQL's `bool` modifier, so the value is
#     always 1 and printing it says nothing. The summary carries the threshold instead.
#   - disable_web_page_preview stops Telegram from pasting a Grafana card under every message.
#   - Times are the Pi's local time because the Grafana service now gets TZ. Without it, Go
#     formats in UTC and every alert reads two hours early.
#   - Interpolated text is not HTML-escaped by Grafana. Keep < & > out of summaries and labels,
#     or Telegram rejects the whole message with a 400.
#   - **No variable assignment.** Grafana's Telegram integration parses this with a restricted
#     parser that rejects `:=` outright: `template: :1: unexpected ":=" in command`. A parse error
#     renders the whole message empty, Telegram answers `message text is empty`, and every alert is
#     dropped with nothing but a warn line in Grafana's log to say so. It went unnoticed from
#     whenever the template was written until 2026-08-21, because the only alerts firing were two
#     nobody was waiting for. Use `len .Alerts` inline, and `$.Alerts` inside a range.
contactPoints:
  - orgId: 1
    name: telegram-homelab
    receivers:
      - uid: telegram-homelab
        type: telegram
        disableResolveMessage: false
        settings:
          bottoken: "${TELEGRAM_ALERT_BOT_TOKEN}"
          chatid: "${TELEGRAM_ALERT_CHAT_ID}"
          parse_mode: HTML
          disable_web_page_preview: true
          message: |
            {{- if eq .Status "firing" -}}
            {{ if eq .CommonLabels.severity "critical" }}🚨{{ else }}⚠️{{ end }} <b>{{ .CommonLabels.alertname }}</b>
            <i>{{ .CommonLabels.severity }}{{ if gt (len .Alerts) 1 }} · {{ len .Alerts }} instances{{ end }}{{ with (index .Alerts 0) }} · since {{ .StartsAt.Format "15:04" }}{{ end }}</i>
            {{- else -}}
            ✅ <b>{{ .CommonLabels.alertname }}</b>
            <i>resolved{{ with (index .Alerts 0) }} after {{ .EndsAt.Sub .StartsAt }}{{ end }}</i>
            {{- end }}
            {{ if eq .Status "firing" }}
            {{ range .Alerts }}
            {{- if gt (len $.Alerts) 1 }}• {{ end }}{{ .Annotations.summary }}
            {{ if .Annotations.description }}<blockquote class="tg-quote">{{ .Annotations.description }}</blockquote>
            {{ end }}
            {{- end }}
            {{- with (index .Alerts 0) }}{{ if .SilenceURL }}
            <a href="{{ .SilenceURL }}">Silence this</a>{{ end }}{{ end }}
            {{- end }}
