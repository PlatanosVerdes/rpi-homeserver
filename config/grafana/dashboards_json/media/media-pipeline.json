                      },
                      "queuedUP": {
                        "color": "semi-dark-green",
                        "index": 5,
                        "text": "queuedUP"
                      },
                      "queuedDL": {
                        "color": "semi-dark-blue",
                        "index": 6,
                        "text": "queuedDL"
                      },
                      "stalledUP": {
                        "color": "purple",
                        "index": 7,
                        "text": "stalledUP"
                      },
                      "stalledDL": {
                        "color": "orange",
                        "index": 8,
                        "text": "stalledDL"
                      },
                      "pausedUP": {
                        "color": "text",
                        "index": 9,
                        "text": "pausedUP"
                      },
                      "stoppedUP": {
                        "color": "text",
                        "index": 10,
                        "text": "stoppedUP"
                      },
                      "pausedDL": {
                        "color": "text",
                        "index": 11,
                        "text": "pausedDL"
                      },
                      "stoppedDL": {
                        "color": "text",
                        "index": 12,
                        "text": "stoppedDL"
                      },
                      "checkingUP": {
                        "color": "yellow",
                        "index": 13,
                        "text": "checkingUP"
                      },
                      "checkingDL": {
                        "color": "yellow",
                        "index": 14,
                        "text": "checkingDL"
                      },
                      "checkingResumeData": {
                        "color": "yellow",
                        "index": 15,
                        "text": "checkingResumeData"
                      },
                      "moving": {
                        "color": "yellow",
                        "index": 16,
                        "text": "moving"
                      },
                      "allocating": {
                        "color": "yellow",
                        "index": 17,
                        "text": "allocating"
                      },
                      "error": {
                        "color": "red",
                        "index": 18,
                        "text": "error"
                      },
                      "missingFiles": {
                        "color": "red",
                        "index": 19,
                        "text": "missingFiles"
                      },
                      "unknown": {
                        "color": "text",
                        "index": 20,
                        "text": "unknown"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
