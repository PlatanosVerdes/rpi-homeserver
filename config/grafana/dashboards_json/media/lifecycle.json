    {
      "type": "table",
      "title": "Films in grace, and the day they go",
      "description": "Maintainerr's rule is 'watched more than two days ago', so this is when each one becomes eligible. Its collection handler runs at 00:00 and 12:00, so the deletion lands at the first of those after the date shown. Empty means nothing has been watched in the last two days.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(maintainerr_pending_since_timestamp + 172800) * 1000",
          "instant": true,
          "range": false,
          "editorMode": "code",
