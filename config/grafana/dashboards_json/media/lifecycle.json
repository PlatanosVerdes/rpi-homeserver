    {
      "type": "table",
      "title": "When each torrent goes",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The countdown qbit-manage is running, read from the client rather than restated here: when a share_limits group claims a torrent it writes the limit into qBittorrent, so the time left is that limit minus what the torrent has already seeded. Joined on the infohash, because cross-seed gives every copy of a release the same name.\n\nOnly torrents a group has claimed appear. The rest are absent for one of two good reasons: no group matched, because the library still shares their bytes, or the group cleared the limit because the torrent moved bytes in the last day and is still paying for itself.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "custom": {
