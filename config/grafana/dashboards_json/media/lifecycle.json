    {
      "type": "logs",
      "title": "What qbit-manage deleted",
      "description": "Its own words, with the box drawing stripped out. `Cleanup: True [Meets Share Limits]` is one torrent going and `Total Torrents + Contents Deleted` is that run's tally. The name sits on a different line from the verdict, so this says when and how many, never which title.",
      "id": 25,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "exact",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "container:qbit-manage (\"Cleanup: True\" OR \"Contents Deleted\") | replace_regexp (\"[|]\", \"\") | replace_regexp (\"\\\\s{2,}\", \" \")",
          "queryType": "range",
          "maxLines": 200
        }
      ]
    },
