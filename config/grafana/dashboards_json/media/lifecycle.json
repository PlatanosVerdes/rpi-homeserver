    {
      "type": "table",
      "title": "When each torrent goes",
      "id": 20,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The countdown qbit-manage is already running, read back from the client instead of restated here: when a share_limits group claims a torrent it writes the limit into qBittorrent, so what is left is that limit minus the time already seeded. Change a group in config/qbit-manage/config.yml and this moves on its own.\n\nJoined on the infohash, because cross-seed gives every copy of a release the same name.\n\nOnly torrents a group has claimed appear here. A torrent missing from the list is an answer, not a gap: either no group matched, because the library still shares its bytes, or the group cleared its limit because it moved bytes in the last day and is still paying for itself.",
      "gridPos": {
        "h": 11,
        "w": 15,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": false,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Torrent"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 330
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hours left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: h"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 48
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Goes on"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Category"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "none": {
                        "text": "added by hand",
                        "index": 0
                      },
                      "cross-seed-link": {
                        "text": "cross-seed",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "countRows": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "desc": false,
            "displayName": "Hours left"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sort((qbit_torrent_seeding_limit_seconds - on(hash) group_left(name, category) qbit_torrent_seeding_seconds) / 3600)",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "(time() + (qbit_torrent_seeding_limit_seconds - on(hash) group_left(name, category) qbit_torrent_seeding_seconds)) * 1000",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "hash",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "hash": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "name 2": true,
              "category 2": true
            },
            "indexByName": {
              "name 1": 0,
              "category 1": 1,
              "Value 1": 2,
              "Value 2": 3
            },
            "renameByName": {
              "name": "Torrent",
              "name 1": "Torrent",
              "category": "Category",
              "category 1": "Category",
              "Value 1": "Hours left",
              "Value #A": "Hours left",
              "Value 2": "Goes on",
              "Value #B": "Goes on"
            }
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Waiting in the recycle bin",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Deleted already, still on the disk. The bin sits under /data/downloads, so nothing is freed until qbit-manage empties it two days after a file lands (recyclebin.empty_after_x_days).\n\nReclaimable is the part that actually comes back. A file the library still hardlinks frees nothing when the bin empties, so the two figures only match while everything in there is held by the bin alone.",
      "gridPos": {
        "h": 5,
        "w": 9,
        "x": 15,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Oldest goes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "recyclebin_bytes",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "Holding"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "recyclebin_reclaimable_bytes",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "Reclaimable"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "(recyclebin_oldest_timestamp + 172800) * 1000",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "Oldest goes"
        }
      ]
    },
