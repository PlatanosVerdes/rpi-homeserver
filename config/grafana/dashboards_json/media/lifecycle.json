    {
      "type": "stat",
      "title": "Should all be zero",
      "id": 24,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Four ways the lifecycle goes wrong, in one place because the answer is normally zero.\n\nEach one falls back to a count of the torrents the exporter can see rather than to a plain zero. A bare `or vector(0)` would answer zero just as confidently when the exporter is dead, which is the one moment the number matters. Written this way, a dead exporter shows No data instead of good news.",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Bytes only a cross-seed holds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(qbit_torrent_no_working_tracker) or (count(qbit_torrent_progress) * 0)",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "Seeding to nobody"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "count(qbit_torrent_unmanaged) or (count(qbit_torrent_progress) * 0)",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "In no retention group"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(qbit_torrent_sole_holder_bytes) or (count(qbit_torrent_progress) * 0)",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "Bytes only a cross-seed holds"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "sum(tracker_hnr_at_risk)",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "legendFormat": "Owed hours with the clock stopped"
        }
      ]
    },
