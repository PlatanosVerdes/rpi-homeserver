    {
      "type": "table",
      "title": "Bytes only a cross-seed is holding",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "A cross-seed normally shares its bytes with the torrent that downloaded them: a second tracker paid for, no extra disk. Anything listed here is the last link to those bytes, so they exist only because of it. That happens by accident rather than by design: cross-seed searches whatever is in the client and a cross-seed is in the client, so A holds it, B gets injected, A expires, and A's tracker still has the content for B to match against. Each hop is finite and earns ratio on its own site; chained, they hold the same bytes indefinitely. Empty is the normal state and the one to expect.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
