{
  "uid": "acestream-channels",
  "title": "Acestream playback",
  "description": "Which channels start, which do not, from acestream-proxy and Farnsworth logs.",
  "tags": [
    "media",
    "acestream"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "type": "table",
      "title": "Streams started",
      "description": "Counted when the proxy sees the first video byte. Jellyfin only: VLC goes straight to the engine and never reaches the proxy.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_time:$__range container:acestream-proxy \"playing after\" | extract \"[proxy] <channel> playing after\" | stats by (channel) count() as starts | sort by (starts desc) | limit 25",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "starts",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "starts"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Streams that never started",
      "description": "Waited the full deadline without a byte, meaning no seeders at that moment. Empty is the healthy state.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_time:$__range container:acestream-proxy \"gave up\" | extract \"[proxy] <channel> gave up\" | stats by (channel) count() as failures | sort by (failures desc) | limit 25",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "failures",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failures"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Handoff method",
      "description": "m3u is the playlist download, vlc the URL scheme. No client column: Docker's userland proxy rewrites the source address at the published port, so every request arrives as the bridge gateway.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_time:$__range container:farnsworth \"[play]\" | extract \"[play] <channel> via <method> from <ip>\" | stats by (method) count() as starts | sort by (starts desc)",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "starts",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "starts"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "logs",
      "title": "Recent activity",
      "description": "Raw proxy and Farnsworth lines, newest first.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_time:$__range (container:acestream-proxy OR container:farnsworth) (\"[proxy]\" OR \"[play]\" OR \"[playlist]\")",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": false,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
  ]
}