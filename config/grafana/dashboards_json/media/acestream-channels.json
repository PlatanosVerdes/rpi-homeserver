{
  "uid": "acestream-channels",
  "title": "Acestream channels",
  "description": "Qué canales arrancan y cuáles no, a partir de lo que registran acestream-proxy y Farnsworth.",
  "tags": [
    "media",
    "acestream"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "type": "table",
      "title": "Canales que arrancaron",
      "description": "Cada vez que un canal empezó a dar vídeo. Solo cuenta lo que pasa por Jellyfin: VLC va directo al motor y no aparece aquí.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_time:$__range container:acestream-proxy \"playing after\" | extract \"[proxy] <channel> playing after\" | stats by (channel) count() as veces | sort by (veces desc) | limit 25",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "veces",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "veces"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Canales que no arrancaron",
      "description": "El proxy esperó 45 segundos y no llegó vídeo: nadie estaba compartiendo ese canal en ese momento. Vacío es buena señal.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_time:$__range container:acestream-proxy \"gave up\" | extract \"[proxy] <channel> gave up\" | stats by (channel) count() as fallos | sort by (fallos desc) | limit 25",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "fallos",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fallos"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Cómo se abren desde Farnsworth",
      "description": "m3u es la descarga de la lista, vlc es el botón que llama a la app. La IP no sirve: Docker la sustituye por la de su puerta de enlace antes de que llegue aquí.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_time:$__range container:farnsworth \"[play]\" | extract \"[play] <channel> via <como> from <ip>\" | stats by (como) count() as veces | sort by (veces desc)",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "veces",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "veces"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "logs",
      "title": "Actividad reciente",
      "description": "Todo lo que dijeron el proxy y Farnsworth, lo más nuevo arriba.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_time:$__range (container:acestream-proxy OR container:farnsworth) (\"[proxy]\" OR \"[play]\" OR \"[playlist]\")",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": false,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
  ]
}