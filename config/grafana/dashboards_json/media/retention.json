    {
      "id": 111,
      "type": "table",
      "title": "Trackers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every tracker with a torrent here, and the goal the cleanup applies to it. Public ones ask nothing: their torrents go as soon as the film leaves the library. Private goals come from config/qbittorrent/seed-rules.json, and either the hours or the ratio clears the debt, whichever lands first.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": false
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tracker"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 240
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disk"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Private"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "private",
                        "color": "orange",
                        "index": 0
                      },
                      "false": {
                        "text": "public",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Or ratio"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "—",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Disk",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "seed_cleanup_goal_hours",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "seed_cleanup_goal_ratio",
          "refId": "B",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "seed_cleanup_tracker_torrents",
          "refId": "C",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "seed_cleanup_tracker_bytes",
          "refId": "D",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "seed_cleanup_tracker_waiting",
          "refId": "E",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "format": "table"
        }
      ],
      "transformations": [
