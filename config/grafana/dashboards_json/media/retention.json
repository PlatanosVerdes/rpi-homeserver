              "__name__ 5": true,
              "private 2": true,
              "private 3": true,
              "private 4": true,
              "private 5": true
            },
            "indexByName": {
              "tracker": 0,
              "private 1": 1,
              "Value #A": 2,
              "Value #B": 3,
