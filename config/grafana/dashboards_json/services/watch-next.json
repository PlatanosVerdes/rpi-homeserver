            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Source"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "jellyfin": {
                        "color": "purple",
                        "index": 1,
                        "text": "jellyfin"
                      },
                      "tautulli": {
                        "color": "orange",
                        "index": 0,
                        "text": "tautulli"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Monitored"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Searched"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "When",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A",
          "expr": "watch_next_action_timestamp * 1000"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true,
              "idx": true
            },
            "renameByName": {
              "source": "Source",
              "title": "Title",
              "season": "Season",
              "episode": "Episode",
              "monitored": "Monitored",
              "searched": "Searched",
              "Value": "When"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "unauthorized: bad/missing token in the webhook URL · bad_payload: not valid JSON (or season/episode missing/unparseable) · missing_tvdb_id:\nTautulli/Jellyfin sent no TVDB id · handle_failed: Sonarr didn't have that series/episode, or its API\ncall failed, check `docker logs watch-next` for the exact one. Last 20, resets when watch-next restarts.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "When"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Source"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "jellyfin": {
                        "color": "purple",
                        "index": 1,
                        "text": "jellyfin"
                      },
                      "tautulli": {
                        "color": "orange",
                        "index": 0,
                        "text": "tautulli"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
