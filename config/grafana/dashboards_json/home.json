          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "__auto",
          "expr": "node_load5"
        }
      ]
    },
    {
      "type": "stat",
      "title": "RAM free",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Available, not unused: cache that can be reclaimed counts as free. Red under 10% would\nmean swapping to the SD card, which is where the \"Memory almost exhausted\" alert sits.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 9,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          },
          "mappings": [],
          "decimals": 0,
          "max": 100,
          "min": 0,
          "links": [
            {
              "title": "What is using the RAM",
              "url": "/d/container-health?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "__auto",
          "expr": "100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Swap cost",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How much of the Pi's RAM the swap actually costs \u2014 the honest version of the ~87% that\nnode_exporter's own SWAP gauge shows in red.\n\nThat gauge measures how full the swap device is. This swap is /dev/zram0: pages compressed in\nRAM, not the SD card. A full one is zram working, and what it costs is not what it holds \u2014\n1.65 GB of pages currently occupy 0.56 GB of real RAM, about 7% of the machine.\n\nIt only climbs if the pages stop compressing, which is the one case worth reacting to.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 13,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "mappings": [],
          "decimals": 0,
          "min": 0,
          "max": 100,
          "links": [
            {
              "title": "Host detail",
              "url": "/d/container-health?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "__auto",
          "expr": "100 * zram_memory_used_bytes{device=\"zram0\"} / ignoring(device) node_memory_MemTotal_bytes"
        }
      ]
    },
