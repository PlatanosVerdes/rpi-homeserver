  "panels": [
    {
      "type": "stat",
      "title": "Services down",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Blackbox probes that got no valid answer. Zero and green is the normal state; click the\nnumber to see which service is failing.",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "links": [
            {
              "title": "Which service is down",
              "url": "/d/service-probes?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "expr": "count(probe_success == 0) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "SoC temperature",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Red at 75 C, the same threshold as the \"Pi running hot\" alert. Sustained throttling\nterritory rather than a brief spike.",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 3,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 65
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          },
          "mappings": [],
          "decimals": 0,
          "links": [
            {
              "title": "Host detail",
              "url": "/d/container-health?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "legendFormat": "__auto",
          "expr": "max(node_thermal_zone_temp)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Load",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Five-minute load average. This Pi has 4 cores, so 4 is the line where work starts queuing\nrather than running; the night qBittorrent was uncapped this sat at 16.",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          },
          "mappings": [],
          "decimals": 1,
          "links": [
            {
              "title": "What is using the CPU",
              "url": "/d/container-health?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
