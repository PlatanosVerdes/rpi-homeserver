# Image versions — single source of truth (like requirements.txt).
#
# Bump a version here, commit, and the auto-deploy applies it.
# Loaded via COMPOSE_ENV_FILES=versions.env,.env (set by deploy/rebuild scripts).
# To run compose manually: export COMPOSE_ENV_FILES=versions.env,.env
#
# These are versions/digests, NOT secrets, so this file IS committed to git.

# --- core ---
CADDY_VERSION=2.11.4
HOMEPAGE_VERSION=v1.13.2
SPEEDTEST_TRACKER_VERSION=v1.14.7-ls165
PIHOLE_VERSION=2026.07.2
CLOUDFLARED_VERSION=2026.7.3

# --- built here, from services/ ---
# Written by the Service images workflow, not by hand: each is the tag it published for that
# directory, v<commit date>-<commit>. The commit in the tag is what the next build compares against,
# so a value it did not write (like `unbuilt`) just means "build it". See docs/service-images.md.
AUDIO_CONVERT_IMAGE_TAG=v2026.10.20-e6196c8
CADDY_IMAGE_TAG=v2026.10.20-236fb7f
FARNSWORTH_IMAGE_TAG=v2026.10.20-236fb7f
PI_METRICS_IMAGE_TAG=v2026.10.20-236fb7f
SUBTITLE_LINKS_IMAGE_TAG=v2026.10.20-236fb7f
TAILSCALE_METRICS_IMAGE_TAG=v2026.10.20-236fb7f
TORRENT_DROP_IMAGE_TAG=v2026.10.20-236fb7f
TRACKER_CONTROL_IMAGE_TAG=v2026.10.20-236fb7f
WATCH_NEXT_IMAGE_TAG=v2026.10.20-236fb7f

# --- media ---
PLEX_VERSION=1.43.3.10861-07dfddaeb-ls318
JELLYFIN_VERSION=10.11.11ubu2604-ls43
SEERR_VERSION=v3.4.1
GLUETUN_VERSION=v3.41.3
DOCKER_SOCKET_PROXY_VERSION=v0.5.0
SLEIPNIR_VERSION=v2026.10.19.1
MUNINN_VERSION=v2026.10.19
BIFROST_VERSION=v2026.10.23.1
# aceserve publishes no version tags, so it is pinned by digest
ACESERVE_DIGEST=sha256:4ce96b430c8dcfbdaea185d9462eae0dd1ff9e560008326c40507faa07fca67f
KUBO_VERSION=v0.43.0
MAINTAINERR_VERSION=3.21.1
TAUTULLI_VERSION=v2.17.2

# --- arrs ---
QBITTORRENT_VERSION=5.2.3_v2.0.13-ls469
QBIT_MANAGE_VERSION=v4.12.0
AUTOBRR_VERSION=v1.84.0
CROSS_SEED_VERSION=6.13.7
FLARESOLVERR_VERSION=v3.5.0
PROWLARR_VERSION=2.5.2.5491-ls156
RADARR_VERSION=6.3.0.10514-ls313
SONARR_VERSION=4.0.19.2979-ls320
BAZARR_VERSION=v1.6.0-ls357
UNPACKERR_VERSION=0.15.2

# --- audio-convert (built here) ---
# Its Dockerfile takes its base images and the two packages audio-compat.py runs on as build args.
# Alpine keeps one version of each package per release, so ~ pins the minor and the release the patch.
AUDIO_CONVERT_GO_IMAGE=1.27.1-alpine3.24
AUDIO_CONVERT_ALPINE_VERSION=3.24.1
AUDIO_CONVERT_FFMPEG_VERSION=8.1
AUDIO_CONVERT_PYTHON_VERSION=3.14

# --- monitoring ---
VICTORIALOGS_VERSION=v1.52.0
VECTOR_VERSION=0.52.0-alpine
PUSHGATEWAY_VERSION=v1.11.3
NODE_EXPORTER_VERSION=v1.12.1
CADVISOR_VERSION=v0.60.5
BLACKBOX_EXPORTER_VERSION=v0.28.0
PROMETHEUS_VERSION=v3.13.2
GRAFANA_VERSION=13.1.2
# qbittorrent-exporter publishes no version tags either, so digest again
QBIT_EXPORTER_DIGEST=sha256:41a7030be19534bf13dfaf3371ec8cdd8a90adf2c29261a075e2255b3ad6e705
# pihole6_exporter publishes no version tags, so it is pinned by digest
PIHOLE_EXPORTER_DIGEST=sha256:daedc7f5c52f4a8895bae0c1a044a3428a1e884da7ada038ca8e2f4f6742de69
