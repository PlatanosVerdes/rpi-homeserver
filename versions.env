# Image versions — single source of truth (like requirements.txt).
#
# Bump a version here, commit, and the auto-deploy applies it.
# Loaded via COMPOSE_ENV_FILES=versions.env,.env (set by deploy/rebuild scripts).
# To run compose manually: export COMPOSE_ENV_FILES=versions.env,.env
#
# These are versions/digests, NOT secrets, so this file IS committed to git.

# --- core ---
# renovate: image=caddy
CADDY_VERSION=2.11.6
# renovate: image=ghcr.io/gethomepage/homepage
HOMEPAGE_VERSION=v2.6.0
# renovate: image=pihole/pihole
PIHOLE_VERSION=2026.10.0
# renovate: image=cloudflare/cloudflared
CLOUDFLARED_VERSION=2026.10.2

# --- built here, from services/ ---
# Written by the Service images workflow, not by hand: each is the tag it published for that
# directory, v<commit date>-<commit>. The commit in the tag is what the next build compares against,
# so a value it did not write (like `unbuilt`) just means "build it". See docs/service-images.md.
AUDIO_CONVERT_IMAGE_TAG=v2026.10.23-45bc285
BAIRD_IMAGE_TAG=v2026.10.27-aae70c3
CADDY_IMAGE_TAG=v2026.10.23-da7a66f
FARNSWORTH_IMAGE_TAG=v2026.10.23-45bc285
SPEEDTEST_IMAGE_TAG=v2026.10.27-6410ffd
PI_METRICS_IMAGE_TAG=v2026.10.23-45bc285
SUBTITLE_LINKS_IMAGE_TAG=v2026.10.23-45bc285
TAILSCALE_METRICS_IMAGE_TAG=v2026.10.23-45bc285
TORRENT_DROP_IMAGE_TAG=v2026.10.23-45bc285
TRACKER_CONTROL_IMAGE_TAG=v2026.10.25-833e7fb
WATCH_NEXT_IMAGE_TAG=v2026.10.23-45bc285

