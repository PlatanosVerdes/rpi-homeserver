# Copy to .env and fill in the secrets. Values that are not secrets are this machine's own.

# --- Host ---
TZ=Europe/Madrid
PUID=1000
PGID=1000
TAILSCALE_IP=100.120.107.32
DATA_ROOT=${HOME}/media_data
CONFIG_ROOT=./config
APP_CONFIG_PATH=./appdata
LOG_LEVEL=info

# --- Media and arrs ---
JELLYFIN_API_KEY=changeme
PLEX_API_TOKEN=changeme
PLEX_CLAIM=
OVERSEERR_API_KEY=changeme
PROWLARR_API_KEY=changeme
RADARR_API_KEY=changeme
SONARR_API_KEY=changeme
QBIT_PASSWORD=changeme
QBIT_WEBUI_PORT=8080

# --- Pi-hole, speedtest ---
PIHOLE_PASSWORD=changeme
SPEEDTEST_API_KEY=changeme
SPEEDTEST_KEY=changeme

# --- VPN for the AceStream engine (gluetun) and its panel (sleipnir) ---
WIREGUARD_PRIVATE_KEY=changeme
VPN_COUNTRY=France
GLUETUN_API_KEY=changeme
SLEIPNIR_NAME=streamhalla
SLEIPNIR_TOKEN=changeme

