# Active profiles — controls which services start
# Profiles: essential, moni, acestream, media, bot, all
# all     → everything
# Use comma-separated values to combine profiles
COMPOSE_PROFILES=all

# Timezone
TZ=Europe/Madrid

# Static IP for Raspberry Pi (configure in your router's DHCP settings)
# Recommended: Reserve this IP in router for RPi's MAC address
# This IP will be used for Pi-hole DNS and as gateway for TV
STATIC_IP=192.168.1.xxx
TAILSCALE_IP=100.xxx.xx.xx

# User permissions (run: id -u and id -g to get your values)
PUID=1000
PGID=1000

# Base data path (path where you'll mount your external disk or RAID)
DATA_ROOT=/mnt/data
DATA_DB_ROOT=/mnt/data/db
CONFIG_ROOT=./config # Static config
APP_CONFIG_PATH=./appdata # Data app

# QBittorrent WebUI Port
QBIT_WEBUI_PORT=8080

# BitTorrent listen port. Pick your own high port and keep it off 6881-6889: that range is the
# obvious one for an ISP to throttle. Whatever goes here is published by compose-arrs.yml, pushed
# into qBittorrent by scripts/sync/qbit-config.sh, and must be what the router forwards. All three
# have to be the same number or there are no incoming connections at all.
QBIT_BT_PORT=49164

# Plex Claim Token
# Get your token at: https://www.plex.tv/claim/
# The token expires in 4 minutes, so copy it just before running docker compose up
PLEX_CLAIM="claim-your_plex_claim_token"

# Networks Plex must treat as local (Settings > Network > LAN Networks), pushed on every deploy
# by scripts/sync/plex-prefs.sh. Without the Tailscale range every tailnet client is billed as
# remote playback. Not a secret: keep this value in sync here.
PLEX_LAN_NETWORKS=100.64.0.0/10,192.168.1.0/24

# Tailscale Auth Key
# Generate your key at: https://login.tailscale.com/admin/settings/keys
# Use a reusable and ephemeral "Auth key" if you prefer
TAILSCALE_AUTHKEY="tskey-auth-your_tailscale_auth_key"

# Grafana admin password (only used the first time Grafana creates its database)
GRAFANA_PASSWORD=change_me

# Pi-hole Web Password
# Password to access Pi-hole admin interface
PIHOLE_PASSWORD="your_secure_password"
# Pi-hole App Password for the Homepage widget (Pi-hole v6+)
# Generate at: Pi-hole admin → Settings → API → Configure app password
PIHOLE_TOKEN=your_pihole_app_password

# API Keys for *arr apps (get from Settings -> General -> Security -> API Key)
# You need to start the services first, then add these keys
PLEX_API_TOKEN=api_key #https://www.plexopedia.com/plex-media-server/general/plex-token/
OVERSEERR_API_KEY=api_key
PROWLARR_API_KEY=api_key
RADARR_API_KEY=api_key
SONARR_API_KEY=api_key
QBIT_PASSWORD="your_qbittorrent_password"

# qBittorrent WebUI user, needed by qbit-manage: it arrives over the Docker bridge, which is not in
# qBittorrent's AuthSubnetWhitelist, so unlike every script here it cannot skip authentication.
QBIT_USER=admin

# How often qbit-manage runs, in minutes
QBIT_MANAGE_SCHEDULE=60
SPEEDTEST_KEY=base64:api_key #echo "base64:$(openssl rand -base64 32)"
SPEEDTEST_API_KEY=api_key
JELLYFIN_API_KEY=api_key
MAINTAINERR_API_KEY=api_key # Maintainerr Settings > General > API key (for the Homepage widget)
TAUTULLI_API_KEY=api_key # Tautulli Settings > Web Interface > API (for the Homepage widget)

## NordVPN (optional, used by some containers for VPN routing)
# Service credentials from the Nord dashboard (Manual setup), not the account login: two
# random 24-character strings. They are what gluetun reads as OPENVPN_USER/OPENVPN_PASSWORD,
# and what the Prowlarr SOCKS5 proxy authenticates with.
NORDVPN_USER=your_nordvpn_service_user
NORDVPN_PASS=your_nordvpn_service_pass

# gluetun. Two routes, and they take different credentials:
#   openvpn   → the two service credentials above, nothing else to get
#   wireguard → WIREGUARD_PRIVATE_KEY below, and the service credentials go unused
# WireGuard is the one to want on a Pi: OpenVPN encrypts on the CPU and that is the
# ceiling for anything routed through it.
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=openvpn
# Only for VPN_TYPE=wireguard. Not the service credentials and not in the dashboard: create an
# access token with the "Get service credentials" permission at
# https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/ and read the key out of
#   curl -s -u token:<ACCESS_TOKEN> https://api.nordvpn.com/v1/users/services/credentials \
#     | jq -r .nordlynx_private_key
# 44 characters, base64. The nordlynx:get_private_key container that circulates no longer works.
WIREGUARD_PRIVATE_KEY=
# OpenVPN only: udp is faster, tcp is the fallback on a network that blocks udp.
VPN_PROTOCOL=udp
# Country to exit through, spelled as gluetun's SERVER_COUNTRIES expects: Netherlands,
# United Kingdom, Spain. One country per gluetun instance — a container joins an instance's
# network namespace, so it inherits that country and cannot pick its own.
VPN_COUNTRY=Netherlands

# Cloudflare API Token (DNS challenge for Let's Encrypt certificates)
# Create at: Cloudflare Dashboard -> My Profile -> API Tokens -> Edit zone DNS template
# Scope: Zone -> DNS -> Edit, limited to your domain only
CF_API_TOKEN=your_cloudflare_api_token

# Email for Let's Encrypt certificate notifications (used by Caddy)
CADDY_EMAIL=your@email.com

# Caddy routes from a companion repo (e.g. rpi-services), mounted into /etc/caddy/ext-services
# and auto-imported by the Caddyfile. Leave unset if you have no companion repo.
# EXT_CADDY_PATH=/home/raspi/rpi-services/config/caddy

# Companion repo root, so Vector collects its cron logs too (one-pace.log and friends).
# Unset, Vector mounts an empty directory and only this repo's logs are collected.
# EXT_LOGS_PATH=/home/raspi/rpi-services

# Cloudflare Tunnel token — only needed for the `tunnel` profile (GitHub deploy webhook).
# Create at: Cloudflare Zero Trust -> Networks -> Tunnels -> Create a tunnel (Cloudflared).
# See docs/deploy-webhook.md. Leave empty if you do not use the webhook.
CLOUDFLARED_TUNNEL_TOKEN=

# Shared secret for the GitHub webhook (services/deploy-webhook). The same value goes in
# the webhook config on GitHub. Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Shared secret for the watch-next webhooks (services/watch-next). The same value goes in the
# Tautulli/Jellyfin webhook URLs. See docs/watch-next.md. Generate one with: openssl rand -hex 32
WATCH_NEXT_TOKEN=
# How many upcoming episodes to keep monitored/searched ahead of what's watched.
WATCH_NEXT_MARGIN=3

# Telegram bot for Grafana alerts (see docs/alerting.md). Create the bot with @BotFather,
# then send it a message and read the chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Dead man's switch (scripts/ops/heartbeat.sh). Create a free check at healthchecks.io
# with a 15 min period and 10 min grace, then paste its ping URL here.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# Backups (scripts/ops/backup.sh) — optional, sensible defaults if unset
# BACKUP_DEST defaults to ${DATA_ROOT}/backups/appdata
BACKUP_DEST=/mnt/data/backups/appdata
# Number of daily archives to keep
BACKUP_RETENTION=7
# Optional offsite copy via rclone (leave empty to disable). e.g. b2:my-bucket/rpi
BACKUP_RCLONE_REMOTE=

