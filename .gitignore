# Compiled binaries
services/tailscale-metrics/tailscale-metrics
services/acestream-updater/acestream-updater

# Pi-specific compose overrides (local setup, not committed)
docker-compose.override.yml

# Environment variables (CRITICAL - contains passwords and API keys)
*.env
# ...but versions.env holds only image versions (no secrets) and IS tracked
!versions.env
# `*.env` only matches what ends in .env, so a hand-made copy like .env.bak-20260824 was not
# covered and one `git add -A` on the Pi would have pushed every secret to a public repo. One was
# sitting there untracked on 2026-08-24.
.env*
!.env.example
.env_copy
.deploy_state
.deploy.lock
.crontab.merged
.last_prune
.bitwarden

# Configuration directories (contains sensitive data)
appdata/*
config/homepage/*
!config/homepage/*.yaml


# Docker volumes and runtime data
*.log
# logrotate keeps four rounds beside each log, and copytruncate leaves them right here in the
# repo root. Without these two lines `git status` on the Pi is permanently dirty with them.
*.log.[0-9]
*.log.[0-9].gz
*.pid
*.sock

# Temporary files
*.tmp
*.swp
*~
.DS_Store

# Backup files
*.backup
*.bak
*.old

# IDE and editor files
.vscode/
.idea/
*.sublime-*
.cursor/

# OS files
Thumbs.db
.Trash-*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv
ENV/

# Node
node_modules/
npm-debug.log
yarn-error.log

# Secrets and keys (extra safety)
*.key
*.pem
*.crt
secrets/
credentials/
