[Unit]
Description=GitHub deploy webhook receiver
After=network-online.target
Wants=network-online.target

[Service]
User=raspi
WorkingDirectory=/home/raspi/rpi-homeserver
ExecStart=/usr/bin/python3 /home/raspi/rpi-homeserver/services/deploy-webhook/deploy-webhook.py
Restart=always
RestartSec=5
# Kill only the main process on stop/restart, not the whole cgroup. The deploy this service
# spawns is a child in that cgroup, and deploy_control.sh restarts this very unit when the
# receiver's code changes: with the default KillMode=control-group that restart would kill the
# deploy that requested it, halfway through.
KillMode=process
# No PrivateTmp: the deploy this service spawns outlives a restart (see KillMode above), and a
# private /tmp is torn down with the old instance, leaving the still-running deploy with no /tmp.
ProtectSystem=full
# No NoNewPrivileges here: the whole job of this service is to launch deploy_control.sh, which
# needs sudo for a couple of root-owned paths under appdata. The flag is inherited by children,
# so setting it silently breaks those steps when the deploy comes from the webhook (it still
# worked from cron, which made it look like a random inconsistency).

[Install]
WantedBy=multi-user.target
